# ============================================================
# fastapi-starter — Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

# Deployment environment. Options: development | production | test
#
# Set to "production" on Railway (and any other live deploy). When
# ENVIRONMENT=production, the app refuses to boot unless DATABASE_URL
# points at a postgresql:// URL — this prevents a deploy that forgets
# to inject DATABASE_URL from silently running against an ephemeral
# SQLite file inside the container.
ENVIRONMENT=development


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# SQLAlchemy async database URL.
# Development (SQLite):
#   sqlite+aiosqlite:///./dev.db
# Production (PostgreSQL):
#   postgresql+asyncpg://user:password@host:5432/dbname
#
# On Railway, the Postgres plugin injects DATABASE_URL with the
# `postgresql://` scheme. The app rewrites it to `postgresql+asyncpg://`
# automatically — no manual fix required.
DATABASE_URL=sqlite+aiosqlite:///./dev.db


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Secret key used for cryptographic signing.
# Must be at least 32 characters. Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

# Base URL of the frontend application.
# Used to construct links in outgoing emails (e.g. verification,
# password reset). No trailing slash.
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated list of allowed CORS origins.
# Must include the frontend URL. No trailing slashes.
# Example for multiple origins:
#   http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173


# ------------------------------------------------------------
# Email
# ------------------------------------------------------------

# Email provider to use for sending transactional email.
# Options: smtp | resend | mock
# Use "mock" in development/testing to suppress real email delivery.
EMAIL_PROVIDER=smtp

# Sender email address shown in the From field of all outgoing emails.
EMAIL_FROM_ADDRESS=noreply@example.com

# Display name shown in the From field of all outgoing emails.
EMAIL_FROM_NAME=My App


# SMTP provider settings (required when EMAIL_PROVIDER=smtp)
# ----------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp-password


# Resend provider settings (required when EMAIL_PROVIDER=resend)
# ----------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here


# ------------------------------------------------------------
# Session
# ------------------------------------------------------------

# Set the Secure flag on the session_id cookie.
# Set to true in production (requires HTTPS).
# Set to false in local development (HTTP).
SESSION_COOKIE_SECURE=false

# SameSite attribute on the session_id cookie. Options: lax | strict | none
#
# Use "lax" (the default) when the frontend and backend share an origin —
# either locally on http://localhost, or in production behind a reverse
# proxy that fronts both services on the same domain. This is the topology
# this starter targets on Railway (Caddy in the frontend service proxies
# /api/* to the backend), so "lax" is correct in both environments.
#
# Use "none" only if the frontend and backend are served from different
# origins. "none" requires SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax


# ------------------------------------------------------------
# Admin Seed
# ------------------------------------------------------------

# Set all four to create a default admin user on first startup.
# If the admin already exists (by email), seeding is skipped.
# Commented out by default — uncomment and set values for your deployment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-immediately
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User


# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

# Enable or disable rate limiting on sensitive endpoints.
# Set to false in test environments to prevent test interference.
RATE_LIMIT_ENABLED=true
